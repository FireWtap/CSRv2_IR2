#!/bin/bash
# Submit from the repo root. Arguments: command config.
#SBATCH --job-name=E7_profiling
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=outputs/slurm/%x-%j.out

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
source jobs/snellius/env.sh
echo "commit $(git rev-parse --short HEAD) | upstream $(git -C third_party/CSRv2 rev-parse --short HEAD) | node $(hostname)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

command="${1:?expected encode or search}"
config="${2:?expected a TOML config}"
if [[ "$#" -ne 2 ]]; then
    echo "Usage: $0 {encode|search} CONFIG" >&2
    exit 2
fi
exec uv run --frozen python -m csrv2_repro.e7_profiling "$command" --config "$config"
