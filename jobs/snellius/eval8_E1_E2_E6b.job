#!/bin/bash
# 8-task evaluations that need no training: E1 dense (both prompt protocols), E2 MRL, E6b released ckpt.
# The dtype is NOT fixed until ledger D-005 is decided, so it must be passed at submit time:
#   sbatch --export=ALL,DTYPE=float32,PART=both jobs/snellius/eval8_E1_E2_E6b.job
# PART selects one backbone pass, so the three can run as parallel jobs:
#   both  = E1 dense (prompt on queries+docs) + E2 MRL from its cache   -> Tab.3 Backbone, MRL
#   e6b   = released CSRv2 ckpt, all k                                   -> Tab.3 CSRv2 (D-006)
#   query = E1 dense (prompt on queries only) + E2 MRL                   -> D-004 protocol check
#   all   = the three in sequence (default; only sensible for bf16)
# Time (measured in E1p, job 28872577): fp32 ~0.18 s/doc -> ~12 h per pass over ~240k docs;
# bf16 ~7.5x faster. Resumable: embedding caches and finished mteb tasks are reused on resubmission.
#SBATCH --job-name=eval8
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=18
#SBATCH --time=24:00:00
#SBATCH --output=outputs/slurm/%x-%j.out

set -euo pipefail
: "${DTYPE:?DTYPE not set: sbatch --export=ALL,DTYPE=bfloat16|float32 (see ledger D-005)}"
case "$DTYPE" in float32|bfloat16) ;; *) echo "DTYPE must be float32 or bfloat16" >&2; exit 2;; esac
PART="${PART:-all}"
case "$PART" in all|both|e6b|query) ;; *) echo "PART must be all|both|e6b|query" >&2; exit 2;; esac
cd "$SLURM_SUBMIT_DIR"
source jobs/snellius/env.sh
echo "commit $(git rev-parse --short HEAD) | upstream $(git -C third_party/CSRv2 rev-parse --short HEAD) | node $(hostname) | dtype $DTYPE | part $PART"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

run() { echo "=== $* ($(date +%T))"; uv run --frozen python -m "$@" --dtype "$DTYPE"; }
# Most informative first, in case of a timeout. E2 reuses E1's embedding cache (same dtype), so each E2
# costs no backbone pass; E1 query-only (D-004 protocol variant) runs last.
if [[ $PART == all || $PART == both ]]; then
  run csrv2_repro.e1_dense_backbone --config configs/E1_dense_both.toml
  run csrv2_repro.e2_mrl --config configs/E2_mrl_both.toml
fi
if [[ $PART == all || $PART == e6b ]]; then
  run csrv2_repro.e0_released_ckpt --config configs/E6b_released_ckpt.toml
fi
if [[ $PART == all || $PART == query ]]; then
  run csrv2_repro.e1_dense_backbone --config configs/E1_dense_query.toml
  run csrv2_repro.e2_mrl --config configs/E2_mrl_query.toml
fi
echo "=== done ($(date +%T))"
